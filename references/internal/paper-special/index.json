        "checkpoints": ["问题分析全面", "方案论证充分", "能总结经验和持续改进"]
      }
    ],
    "deductions": [
      "摘要缺失、过短或没有实质内容",
      "正文只按条目罗列，缺少项目叙事",
      "过分自我吹嘘或夸大其词",
      "内容有明显错误或漏洞",
      "项目背景水平过低或像学生实习"
    ],
    "fatal_risks": [
      "虚构情节或明显不可信",
      "主要从书本资料摘录，缺少实际经验",
      "内容不切题或空泛",
      "正文与摘要篇幅过短，尤其正文少于1500字",
      "文理不通、错别字多、思路混乱"
    ]
  },
  "framework": {
    "source": "references/internal/paper-special/02-论文框架与格式.md",
    "role_logic": "用管理思维落地规划，用规划视角优化管理",
    "role_guidance": [
      "规划类题目优先采用甲方视角，强调战略落地、总体蓝图和路线图。",
      "管理类题目可采用乙方或运维服务视角，强调合同边界、服务质量和持续改进。",
      "同一篇论文中角色、职责、权力边界要前后一致。"
    ],
    "abstract": {
      "target_chars": "200-300",
      "must_include": ["项目背景", "本人角色", "核心方法", "关键措施", "量化效果"]
    },
    "body": {
      "target_chars": "2200-2500",
      "time_budget": "90分钟左右",
      "sections": [
        "背景介绍：项目背景、目标、组织结构、服务对象、交付成果和本人职责",
        "理论认识：围绕题目要求解释特点、原则、方法或管理机制",
        "具体做法：结合项目写规划、实施、治理、安全、数据、资源和组织保障",
        "效果总结：用量化指标、风险处置、经验教训和持续改进收束"
      ]
    }
  },
