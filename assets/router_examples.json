{
  "schema_version": 1,
  "description": "Natural-language routing regression examples for scripts/study.py ask. Add high-risk wording here instead of hard-coding ask cases in study.py.",
  "defaults": {
    "format": "markdown",
    "no_record": true,
    "dry_run": false
  },
  "examples": [
    {
      "name": "dashboard_today",
      "text": "今天我该学什么",
      "execute": true,
      "expected_intent": "dashboard",
      "expected_command_contains": "dashboard",
      "expected_output_contains": "学习驾驶舱"
    },
    {
      "name": "plan_today",
      "text": "给我安排今日计划",
      "execute": true,
      "expected_intent": "plan",
